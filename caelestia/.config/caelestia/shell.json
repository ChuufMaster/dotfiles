{
    "dashboard": {
        "showClockSeconds": true
    },
    "general": {
        "apps": {
            "terminal": [
                "kitty"
            ]
        },
        "idle": {
            "timeouts": [
                {
                    "timeout": 180,
                    "idleAction": "lock"
                },
                {
                    "timeout": 300,
                    "idleAction": "dpms off",
                    "returnAction": "dpms on"
                }
            ]
        }
    },
    "paths": {
        "wallpaperDir": "~/wallpapers"
    },
    "border": {
        "thickness": 3
    }
}
