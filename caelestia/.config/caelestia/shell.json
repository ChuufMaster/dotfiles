            ]
        },
        "idle": {
            "timeouts": [
                {
                    "enabled": true,
                    "idleAction": "lock",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 180
                },
                {
                    "enabled": true,
                    "idleAction": "dpms off",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 300
                }
            ]
        }
    },
    "paths": {
        "wallpaperDir": "~/wallpapers"
    },
    "services": {
        "brightnessIncrement": 0.2
    }
}
